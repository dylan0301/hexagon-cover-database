{
  "latex-workshop.latex.recipe.default": "latexmk (xelatex, fast local preview)",
  "latex-workshop.latex.outDir": "%TMPDIR%",
  "latex-workshop.latex.auxDir": "%OUTDIR%",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (xelatex, fast local preview)",
      "tools": [
        "latexmk-xelatex-temp"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xelatex-temp",
      "command": "latexmk",
      "cwd": "%DIR%",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-xelatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ]
}
