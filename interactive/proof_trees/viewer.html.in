<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hexagon proof trees</title>
<style>
:root{color-scheme:light;--ink:#18232e;--muted:#536575;--line:#d1dce4;--accent:#155786;--paper:#fff;--wash:#f3f6f8;--focus:#cde3f2}
*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:16px/1.62 system-ui,-apple-system,"Segoe UI",sans-serif}
header{position:sticky;top:0;z-index:2;background:#142b3b;color:white;border-bottom:1px solid #142b3b;padding:13px max(22px,calc((100vw - 1160px)/2))}
.brand{display:flex;gap:14px;align-items:baseline;flex-wrap:wrap;margin-bottom:9px}.brand strong{font-size:18px;letter-spacing:.01em}.brand span{font-size:12px;color:#c6d6e0}.toolbar{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.toolbar select{min-width:240px;flex:1;max-width:700px}.toolbar button,.toolbar select{font:inherit;font-size:13px;line-height:1.5;padding:6px 9px;border:1px solid #8399a8;border-radius:5px;background:white;color:#18232e}.toolbar button{cursor:pointer}.toolbar button:disabled{opacity:.45;cursor:default}
main{max-width:1160px;margin:24px auto 36px;padding:27px 38px 32px;background:var(--paper);border:1px solid #dce4e9;border-radius:8px;box-shadow:0 2px 10px #142b3b08;min-height:60vh}
h1{font-size:27px;line-height:1.3;margin:2px 0 12px;font-weight:690;letter-spacing:-.02em}h2{font-size:18px;margin:29px 0 12px;border-bottom:1px solid var(--line);padding-bottom:7px}p{margin:10px 0 14px}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #69a9d2;outline-offset:3px}.node-link{font-weight:660;white-space:nowrap}.external{font-size:.94em}code{background:#eff3f6;border-radius:3px;padding:1px 4px;font-size:.87em;overflow-wrap:anywhere}hr{border:0;border-top:1px solid var(--line);margin:28px 0 15px}strong{font-weight:650}
ul.proof-tree{list-style:none;padding:0;margin:15px 0 18px}.proof-tree ul{list-style:none;border-left:1px solid var(--line);padding:0 0 0 22px;margin:7px 0 9px 7px}.proof-tree li{position:relative;margin:9px 0;padding-left:3px}.proof-tree ul>li:before{content:"";position:absolute;left:-22px;top:.84em;width:16px;border-top:1px solid var(--line)}.proof-tree>li{padding-left:0;margin:14px 0}.proof-tree summary{cursor:pointer;list-style-position:outside;margin-left:15px;padding:1px 0 1px 1px}.proof-tree summary::marker{color:#557586;font-size:.78em}.proof-tree details[open]>summary{margin-bottom:5px}.proof-tree details:not([open])>summary{color:#233d50}.proof-tree li>p{margin:6px 0}.proof-tree li>details>p{margin:8px 0}.math-inline{white-space:normal}math{font-size:1.05em}.math-display{overflow-x:auto;max-width:100%;padding:9px 4px;margin:10px 0}a.node-link:hover{background:#e9f3fa;border-radius:3px}#status{max-width:1160px;margin:0 auto 25px;color:var(--muted);font-size:12px;padding:0 12px}.hint{font-size:13px;color:var(--muted);margin-top:18px}.local-terms{border:1px solid var(--line);border-radius:6px;padding:12px 17px;margin:22px 0;background:#f8fafb}.local-terms>summary{cursor:pointer;font-weight:650}.local-terms>.proof-tree{font-size:.94em}.empty{padding:30px;background:white}blockquote{border-left:3px solid #aec4d2;padding-left:14px;color:var(--muted)}
@media(max-width:700px){body{font-size:15px}header{padding:10px 12px}.brand{margin-bottom:7px}.brand span{display:none}main{margin:10px 0;padding:20px 16px;border-radius:0;border-left:0;border-right:0}h1{font-size:23px}.toolbar select{min-width:100%;max-width:100%;order:2}.toolbar button{font-size:12px}.proof-tree ul{padding-left:17px}.proof-tree ul>li:before{left:-17px;width:12px}.math-inline{overflow-wrap:anywhere}}
@media print{header,#status,.hint{display:none}body{background:white;font-size:10pt}main{border:0;box-shadow:none;max-width:none;margin:0;padding:0}a{color:inherit}details:not([open])>*:not(summary){display:block}h1{font-size:18pt}h2{font-size:13pt}}
</style></head><body>
<header><div class="brand"><strong>HEXAGON / PROOF TREES</strong><span>__PAGE_COUNT__ linked Markdown pages · geometric flow above the calculation cutoff</span></div>
<nav class="toolbar" aria-label="Proof navigation"><button id="back" type="button">← Back</button><button id="home" type="button">Main tree</button><button id="intro" type="button">Start here</button><button id="glossary" type="button">Glossary</button><select id="page-select" aria-label="Choose a proof tree">__PAGE_OPTIONS__</select><button id="expand" type="button">Expand all</button><button id="collapse" type="button">Collapse all</button></nav></header>
<main id="content" aria-live="polite"></main><div id="status"></div>
<script id="proof-pages" type="application/json">__PAGE_DATA__</script>
<script>
'use strict';
const pages=JSON.parse(document.getElementById('proof-pages').textContent);
const content=document.getElementById('content');
const select=document.getElementById('page-select');
const trail=[];
let current=null;
const state=new Map();
function remember(){if(current)state.set(current,Array.from(content.querySelectorAll('details')).map(d=>d.open));}
function route(){
  let id=decodeURIComponent(location.hash.replace(/^#\//,''))||'MAIN';
  if(!pages[id])id='MAIN';
  if(current===id)return;
  remember();
  if(current)trail.push(current);
  current=id;
  const p=pages[id];
  content.innerHTML=p.html;
  if(state.has(id))content.querySelectorAll('details').forEach((d,i)=>d.open=state.get(id)[i]??true);
  select.value=id;
  document.title='['+id+'] '+p.title+' — Hexagon proof trees';
  document.getElementById('status').textContent=p.file+'  ·  Local Markdown links navigate within this viewer. Source links open the pinned GitHub proof.';
  document.getElementById('back').disabled=trail.length===0;
  window.scrollTo({top:0,behavior:'instant'});
}
window.addEventListener('hashchange',route);
select.addEventListener('change',()=>{location.hash='/'+select.value;});
document.getElementById('intro').addEventListener('click',()=>location.hash='/START');
document.getElementById('glossary').addEventListener('click',()=>location.hash='/GLOSSARY');
document.getElementById('home').addEventListener('click',()=>location.hash='/MAIN');
document.getElementById('expand').addEventListener('click',()=>content.querySelectorAll('details').forEach(d=>d.open=true));
document.getElementById('collapse').addEventListener('click',()=>content.querySelectorAll('details').forEach(d=>d.open=false));
document.getElementById('back').addEventListener('click',()=>{
 if(!trail.length)return;
 const target=trail.pop();
 remember();current=null;
 location.hash='/'+target;
 route();
});
// A label link navigates; clicking elsewhere in its summary toggles the branch.
content.addEventListener('click',ev=>{const a=ev.target.closest('a');if(a&&a.closest('summary'))ev.stopPropagation();});
route();
</script></body></html>