from __future__ import annotations

import json
import re
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def p(rel: str) -> Path:
    return ROOT / rel


def read(rel: str) -> str:
    return p(rel).read_text(encoding="utf-8")


def write(rel: str, text: str) -> None:
    path = p(rel)
    path.parent.mkdir(parents=True, exist_ok=True)
    if text and not text.endswith("\n"):
        text += "\n"
    path.write_text(text, encoding="utf-8")


def replace_exact(rel: str, old: str, new: str, *, count: int = 1) -> None:
    text = read(rel)
    actual = text.count(old)
    if actual != count:
        raise RuntimeError(f"{rel}: expected {count} copies of {old!r}, found {actual}")
    write(rel, text.replace(old, new, count))


def replace_regex(rel: str, pattern: str, repl: str, *, count: int = 1, flags: int = re.S) -> None:
    text = read(rel)
    new_text, actual = re.subn(pattern, repl, text, count=count, flags=flags)
    if actual != count:
        raise RuntimeError(f"{rel}: expected {count} regex replacement(s), found {actual}: {pattern}")
    write(rel, new_text)


def replace_if_present(rel: str, old: str, new: str) -> int:
    text = read(rel)
    n = text.count(old)
    if n:
        write(rel, text.replace(old, new))
    return n


def replace_in_tree(roots: list[str], replacements: list[tuple[str, str]]) -> None:
    for root in roots:
        base = p(root)
        if not base.exists():
            continue
        paths = [base] if base.is_file() else list(base.rglob("*"))
        for path in paths:
            if not path.is_file() or path.suffix.lower() not in {".md", ".tex", ".txt", ".py", ".yml", ".yaml"}:
                continue
            text = path.read_text(encoding="utf-8")
            original = text
            for old, new in replacements:
                text = text.replace(old, new)
            if text != original:
                path.write_text(text, encoding="utf-8")


